<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>KromaRec.Patch</AssemblyName>
        <Product>KromaRec Patch for Rec Room 20230414</Product>
        <Version>0.3.1</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>10.0</LangVersion>
        <RootNamespace>RecNetPlugin</RootNamespace>
    </PropertyGroup>
  
    <ItemGroup>
        <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
    </ItemGroup>

    <!-- GamePath = root of a Rec Room install whose BepInEx/interop/ has been populated.
         It is intentionally NOT hardcoded here so the repo is distributable. Set it via ONE of:
           1. a local GamePath.props file (copy GamePath.props.example -> GamePath.props; gitignored)
           2. a RECROOM_PATH environment variable
           3. the command line: dotnet build -p:GamePath="D:\Path\To\RecRoom" -->
    <Import Project="$(MSBuildThisFileDirectory)GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)GamePath.props')" />

    <PropertyGroup>
        <GamePath Condition="'$(GamePath)' == '' and '$(RECROOM_PATH)' != ''">$(RECROOM_PATH)</GamePath>
    </PropertyGroup>

    <PropertyGroup>
        <LoaderPath Condition="'$(LoaderPath)' == ''">$(GamePath)/BepInEx/core</LoaderPath>
    </PropertyGroup>

    <Target Name="ValidateGamePath" BeforeTargets="ResolveAssemblyReferences;Build">
        <Error Condition="'$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/interop/Assembly-CSharp.dll')"
               Code="KRBUILD_INTEROP" Text="Point GamePath at the 20230414 depot after launching it once with BepInEx 6.0.0-pre.2 IL2CPP. See BUILDING.md." />
        <Error Condition="!Exists('$(GamePath)/BepInEx/interop/PhotonRealtime.dll') Or !Exists('$(GamePath)/BepInEx/interop/Photon3Unity3D.dll')"
               Code="KRBUILD_INTEROP" Text="Missing generated 20230414 Photon interop assemblies. See BUILDING.md." />
        <Error Condition="!Exists('$(LoaderPath)/BepInEx.Core.dll') Or !Exists('$(LoaderPath)/BepInEx.Unity.IL2CPP.dll') Or !Exists('$(LoaderPath)/0Harmony.dll') Or !Exists('$(LoaderPath)/Il2CppInterop.Runtime.dll') Or !Exists('$(LoaderPath)/Il2CppInterop.Common.dll')"
               Code="KRBUILD_LOADER" Text="Missing BepInEx 6 IL2CPP or HarmonyX in LoaderPath. See BUILDING.md." />
    </Target>

    <ItemDefinitionGroup>
        <Reference>
            <Private>false</Private>
        </Reference>
    </ItemDefinitionGroup>
    <ItemGroup>
        <Reference Include="BepInEx.Core" HintPath="$(LoaderPath)/BepInEx.Core.dll" />
        <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(LoaderPath)/BepInEx.Unity.IL2CPP.dll" />
        <Reference Include="Il2CppInterop.Runtime" HintPath="$(LoaderPath)/Il2CppInterop.Runtime.dll" />
        <Reference Include="Il2CppInterop.Common" HintPath="$(LoaderPath)/Il2CppInterop.Common.dll" />
        <Reference Include="0Harmony" HintPath="$(LoaderPath)/0Harmony.dll" />
    </ItemGroup>

